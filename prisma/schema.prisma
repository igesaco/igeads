datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// A customer account of the SaaS (an agency or a single business). Every data row below belongs to one.
model Organization {
  id               String    @id @default(cuid())
  name             String
  type             String    @default("agency") // agency, business
  plan             String    @default("trial") // trial, starter, growth, agency
  planStatus       String    @default("trialing") // trialing, active, past_due, canceled
  billingCycle     String    @default("monthly") // monthly, annual
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime? // null with an active plan = no expiry (platform owner's own account)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users    User[]
  payments Payment[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String
  role           String       @default("member") // owner, admin, member
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String       @default("iyzico")
  plan           String
  billingCycle   String
  amount         Float
  currency       String       @default("TRY")
  status         String       @default("pending") // pending, paid, failed
  token          String?      @unique // checkout form token
  providerRef    String? // payment id at the provider
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Client {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  slug           String
  sector         String // "Temizlik & Koltuk Yıkama", "E-Ticaret & Moda", "B2B & SaaS", etc.
  description    String?
  targetAudience String?
  monthlyBudget  Float    @default(25000)
  currency       String   @default("TRY")
  status         String   @default("active") // active, paused, onboarding
  contactPerson  String?
  contactPhone   String?
  metaAccountId  String?
  googleAdsId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns Campaign[]
  products  Product[]

  @@unique([organizationId, slug])
}

model Campaign {
  id                     String   @id @default(cuid())
  organizationId         String?
  name                   String
  clientId               String?
  client                 Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform               String // meta, google, tiktok, chatgpt, whatsapp
  status                 String // active, paused, fatigued
  dailyBudget            Float
  spent                  Float    @default(0)
  revenue                Float    @default(0)
  roas                   Float    @default(0)
  poas                   Float    @default(0)
  cpc                    Float    @default(0)
  ctr                    Float    @default(0)
  fatigueScore           Int      @default(0)
  targetMarketplaceStock Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([organizationId])
}

model Product {
  id              String    @id @default(cuid())
  organizationId  String?
  name            String
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sku             String
  marketplace     String // Trendyol, Hepsiburada, Amazon, Direct
  stock           Int
  price           Float
  buyboxPrice     Float
  isBuybox        Boolean   @default(true)
  returnRate      Float     @default(0)
  // Unit economics entered by the seller; null until entered (no assumed defaults)
  cogs            Float?
  shippingCost    Float?
  commissionRate  Float? // percent
  // Set only when the marketplace actually reported buybox data; null = buybox state unknown
  buyboxCheckedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([organizationId, sku])
}

model AutomationRule {
  id             String    @id @default(cuid())
  organizationId String?
  title          String
  category       String // budget, stock, creative, repricer
  trigger        String
  action         String
  enabled        Boolean   @default(true)
  impactScore    Int       @default(90)
  lastTriggered  String    @default("Az önce")
  // Structured form evaluated by the rules engine (src/lib/rules-engine.ts); null = descriptive only
  metric         String? // product_stock_below, campaign_roas_below, campaign_roas_above
  threshold      Float?
  actionType     String? // notify, pause_campaign
  timesTriggered Int       @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String?
  title          String
  message        String
  type           String // warning, success, info, alert
  time           String   @default("Şimdi")
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model IntegrationConfig {
  id             String    @id @default(cuid())
  organizationId String?
  provider       String // meta, google, tiktok, trendyol, amazon, hepsiburada, whatsapp
  name           String
  category       String // ads, marketplace, messaging
  connected      Boolean   @default(false)
  accountName    String?
  credentials    String // JSON string for keys: { apiKey, apiSecret, accessToken, ... }
  syncFrequency  String    @default("Her 10 dakikada bir")
  lastSync       DateTime?
  status         String    @default("configured") // active, error, configured
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, provider])
}

model TeamMember {
  id              String   @id @default(cuid())
  organizationId  String?
  name            String
  email           String
  role            String // admin, media_buyer, creative, account_manager
  roleTitle       String // "Ajans Kurucusu", "Kıdemli Medya Satın Alıcı", "Kreatif & Metin Yazarı", "Müşteri Yöneticisi"
  phone           String?
  assignedClients String   @default("*") // JSON or comma-separated client slugs, or "*" for all
  status          String   @default("active") // active, away, offline
  avatarColor     String   @default("indigo")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, email])
}

model AgencyTask {
  id             String   @id @default(cuid())
  organizationId String?
  title          String
  description    String?
  clientSlug     String // mandalinclean, igesaturkiye, etc.
  clientName     String // Mandalin Clean, etc.
  assignedTo     String? // TeamMember name
  stage          String   @default("idea") // idea, in_progress, review, ready_to_publish, published
  priority       String   @default("medium") // low, medium, high, urgent
  dueDate        String? // "Bugün 18:00", "Yarın"
  creativeHook   String? // Generated hook text
  channel        String   @default("meta") // meta, google, tiktok, reels
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model AgencyContract {
  id                   String   @id @default(cuid())
  organizationId       String?
  clientSlug           String
  clientName           String
  planType             String   @default("retainer_commission") // retainer_commission, fixed_retainer, performance_fee
  planTitle            String
  monthlyRetainer      Float    @default(0)
  commissionRate       Float    @default(0) // e.g. 8 for 8%
  currentMonthAdSpend  Float    @default(0)
  calculatedCommission Float    @default(0)
  totalMonthlyFee      Float    @default(0)
  status               String   @default("pending") // paid, pending, due
  dueDate              String
  lastPaymentDate      String?
  contractStartDate    String
  contractRenewalDate  String
  invoiceNumber        String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organizationId])
}

// WhatsApp Cloud API messages: inbound ones arrive via the webhook, outbound ones are sent from the inbox
model WhatsAppMessage {
  id             String   @id @default(cuid())
  organizationId String
  waId           String // customer's WhatsApp number (digits only)
  customerName   String?
  direction      String // in, out
  text           String
  waMessageId    String?  @unique
  status         String   @default("received") // received, sent, delivered, read, failed
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([organizationId, waId])
}
