# Copy to .env.local and fill in. Never commit the real file.

# PostgreSQL (Neon in production, any local Postgres in development)
DATABASE_URL="postgresql://user:password@localhost:5432/igeads"

# Session signing secret (required in production). Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Agency admin login (required in production; in development defaults to admin@igeads.com / igeads-dev)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Ajans Yöneticisi"

# Google Gemini (optional; without it the template engines are used)
GEMINI_API_KEY=""
# Optional comma-separated model list, tried in order
GEMINI_MODELS=""

# Trendyol (optional overrides)
TRENDYOL_API_BASE="https://apigw.trendyol.com/integration"
TRENDYOL_STOREFRONT_CODE="TR"
