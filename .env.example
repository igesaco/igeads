# ==========================================
# İgeAds Production Environment Variables
# ==========================================

# 1. Neon Serverless PostgreSQL Database Connection
# Neon Konsolundan (https://console.neon.tech) alacağınız connection string:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 2. Google Gemini AI Engine
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 3. Application URL (Vercel)
NEXT_PUBLIC_APP_URL="https://igeads.vercel.app"
